{
  "java-boot": {
    "label": "JVM — Gradle / Spring Boot (multi-module JAR deploy)",
    "roles": [
      "api",
      "worker"
    ],
    "configGen": true,
    "acceptsGlobalCredentials": true,
    "deployKind": "runtime",
    "layoutSimulator": "simulate-backend-layout.ps1",
    "runtime": "bash",
    "commands": {
      "deploy": "sh/deploy.sh",
      "dev": "sh/dev.sh",
      "manage": "sh/manage.sh",
      "compose": "sh/compose.sh",
      "check": "sh/check.sh",
      "modules": "sh/modules.sh",
      "build": "ps1/build.ps1",
      "test": "ps1/test.ps1"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {
      "devWatch": [
        "dev",
        "watch"
      ]
    },
    "vscode": {
      "launch": "java"
    },
    "migrations": {
      "globs": [
        "src/main/resources/db/migration/**/*.sql"
      ],
      "data": [
        "(?i)\\binsert\\s+into\\b",
        "(?i)\\bcopy\\s+\\S+\\s.*\\bfrom\\b",
        "(?i)\\bupdate\\s+\\S+\\s+set\\b",
        "(?i)\\bdelete\\s+from\\b"
      ]
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "remote-dev": {
        "command": "dev"
      },
      "release": {
        "command": "deploy",
        "args": [
          "all",
          "--{environment}"
        ],
        "forwards": [
          "--no-build",
          "--skip-checks"
        ]
      }
    },
    "operands": {
      "watch": {
        "to": [
          "dev",
          "watch"
        ],
        "hint": "<alias> watch is <alias> dev watch (rsync + bootRun in workspace/); <alias> deploy watch is the bootJar publish loop"
      }
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-java",
          "with": {
            "distribution": "temurin",
            "java-version": "{toolchain.version|17}"
          }
        }
      ]
    },
    "detect": {
      "all": [
        {
          "any": [
            {
              "file": "build.gradle",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "build.gradle.kts",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "settings.gradle"
            },
            {
              "file": "settings.gradle.kts"
            }
          ]
        },
        {
          "any": [
            {
              "file": "build.gradle",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "build.gradle.kts",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "*/build.gradle",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "*/build.gradle.kts",
              "matches": "org\\.springframework\\.boot"
            }
          ]
        }
      ]
    }
  },
  "node-vite": {
    "label": "Node — SPA dev remote + static deploy (Vite, Angular, Nx)",
    "roles": [
      "ui"
    ],
    "deployKind": "static",
    "layoutSimulator": "simulate-frontend-layout.ps1",
    "runtime": "powershell",
    "commands": {
      "deploy": "ps1/deploy.ps1",
      "dev": "ps1/dev.ps1",
      "manage": "ps1/manage.ps1",
      "compose": "ps1/compose.ps1",
      "check": "ps1/check.ps1"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {
      "devWatch": [
        "dev",
        "watch"
      ],
      "deployWatch": [
        "deploy",
        "watch"
      ]
    },
    "vscode": {
      "launch": "node-terminal"
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "remote-dev": {
        "command": "dev"
      },
      "release": {
        "command": "deploy",
        "args": [
          "dist",
          "-Environment",
          "{environment}"
        ]
      }
    },
    "operands": {
      "watch": {
        "to": [
          "deploy",
          "watch"
        ],
        "hint": "<alias> watch is <alias> deploy watch (static dist on the server); <alias> dev watch syncs source to the remote dev container"
      }
    },
    "packageScripts": {
      "lint": "lint",
      "build": "build",
      "test": "test"
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-node",
          "with": {
            "node-version": "{toolchain.version|22}"
          }
        },
        {
          "run": "corepack enable"
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "package.json"
        },
        {
          "any": [
            {
              "file": "vite.config.ts"
            },
            {
              "file": "vite.config.js"
            },
            {
              "file": "vite.config.mjs"
            }
          ]
        }
      ]
    }
  },
  "node-api": {
    "label": "Node — HTTP service (pnpm build + dockerized deploy, Fastify/Express/Nest)",
    "roles": [
      "api"
    ],
    "deployKind": "runtime",
    "runtime": "bash",
    "commands": {
      "deploy": "sh/deploy.sh",
      "dev": "sh/dev.sh",
      "manage": "sh/manage.sh",
      "compose": "sh/compose.sh",
      "check": "sh/check.sh",
      "modules": "sh/modules.sh"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {
      "devWatch": [
        "dev",
        "watch"
      ]
    },
    "vscode": {
      "launch": "node-terminal"
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "remote-dev": {
        "command": "dev"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "release": {
        "command": "deploy",
        "args": [
          "--{environment}"
        ],
        "forwards": [
          "--no-build",
          "--skip-checks"
        ]
      }
    },
    "packageScripts": {
      "lint": "lint",
      "build": "build",
      "test": "test"
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-node",
          "with": {
            "node-version": "{toolchain.version|22}"
          }
        },
        {
          "run": "corepack enable"
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "package.json",
          "matches": "\"(express|fastify|@nestjs/core|koa|@hapi/hapi)\"\\s*:"
        },
        {
          "none": "angular.json"
        },
        {
          "none": "vite.config.*"
        }
      ]
    }
  },
  "dotnet-aspnet": {
    "label": "ASP.NET Core - dotnet run / dotnet publish artifact (Windows or cross-platform host)",
    "roles": [
      "api"
    ],
    "deployKind": "artifact",
    "runtime": "powershell",
    "commands": {
      "deploy": "ps1/deploy.ps1",
      "check": "ps1/check.ps1",
      "build": "ps1/build.ps1",
      "test": "ps1/test.ps1",
      "lint": "ps1/lint.ps1"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "launch": "dotnet"
    },
    "migrations": {
      "globs": [
        "**/Migrations/*.cs"
      ],
      "exclude": [
        "**/Migrations/*.Designer.cs",
        "**/Migrations/*ModelSnapshot.cs"
      ],
      "data": [
        "\\.(InsertData|UpdateData|DeleteData)\\s*\\(",
        "(?i)\\.Sql\\s*\\(\\s*@?\\$?\\\"\\s*(insert\\s+into|update\\s+\\S+\\s+set|delete\\s+from)"
      ]
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "release": {
        "command": "deploy",
        "args": [
          "artifact"
        ]
      },
      "container": {
        "pending": "an image built by `dotnet publish` in a multi-stage Dockerfile and run by the stack compose; declared, not built -- it has to be proven against a docker host first"
      }
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-dotnet",
          "with": {
            "dotnet-version": "{toolchain.version|8.0.x}"
          }
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "*.csproj",
          "matches": "Sdk=\"Microsoft\\.NET\\.Sdk\\.Web\""
        }
      ],
      "reads": {
        "dotnet.project": {
          "name": "*.csproj",
          "matches": "Sdk=\"Microsoft\\.NET\\.Sdk\\.Web\""
        },
        "dotnet.test": {
          "find": "**/*.csproj",
          "matches": "Microsoft\\.NET\\.Test\\.Sdk",
          "mentions": "dotnet.project"
        }
      }
    }
  },
  "node-spa": {
    "label": "Node - single-page app run by its own package.json scripts (Angular CLI, Vite, React, Vue, Svelte)",
    "roles": [
      "ui"
    ],
    "runtime": "powershell",
    "commands": {},
    "packageScripts": {
      "lint": "lint",
      "build": "build",
      "test": "test",
      "start": "start"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "launch": "node-terminal"
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "release": {
        "pending": "a static deploy of the build output: where the output lands is the framework's (angular.json outputPath, vite outDir), so it must be declared by the module and proven against a server first"
      }
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-node",
          "with": {
            "node-version": "{toolchain.version|22}"
          }
        },
        {
          "run": "corepack enable"
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "package.json"
        },
        {
          "file": "angular.json"
        }
      ]
    }
  }
}
