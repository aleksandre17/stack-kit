{
  "java-boot": {
    "label": "JVM — Gradle / Spring Boot (multi-module JAR deploy)",
    "roles": [
      "api",
      "worker"
    ],
    "configGen": true,
    "acceptsGlobalCredentials": true,
    "commands": {
      "build": "ps1/build.ps1",
      "test": "ps1/test.ps1"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "label": "{module}: Spring Boot",
      "values": {
        "mainClass": [
          {
            "field": "debug.java.mainClass"
          },
          {
            "field": "debug.mainClass"
          },
          {
            "glob": "src/main/java/**/*Application.java",
            "as": "dotted",
            "under": "src/main/java"
          }
        ],
        "projectName": [
          {
            "field": "debug.java.projectName"
          },
          {
            "field": "debug.projectName"
          },
          {
            "file": [
              "settings.gradle.kts",
              "settings.gradle"
            ],
            "capture": "rootProject\\.name\\s*=\\s*[\"']([^\"']+)[\"']"
          }
        ]
      },
      "launch": {
        "name": "{label}",
        "type": "java",
        "request": "launch",
        "mainClass": "{mainClass}",
        "cwd": "{path}",
        "projectName": "{projectName}",
        "envFile": "{envFile}",
        "env": {
          "SPRING_PROFILES_ACTIVE": "{hybrid.springProfiles}"
        }
      },
      "optional": [
        "projectName",
        "env"
      ]
    },
    "migrations": {
      "globs": [
        "src/main/resources/db/migration/**/*.sql"
      ],
      "data": [
        "(?i)\\binsert\\s+into\\b",
        "(?i)\\bcopy\\s+\\S+\\s.*\\bfrom\\b",
        "(?i)\\bupdate\\s+\\S+\\s+set\\b",
        "(?i)\\bdelete\\s+from\\b"
      ]
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "remote-dev": {
        "via": "dev"
      },
      "release": {
        "via": "release"
      }
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-java",
          "with": {
            "distribution": "temurin",
            "java-version": "{toolchain.version|17}"
          }
        }
      ]
    },
    "detect": {
      "all": [
        {
          "any": [
            {
              "file": "build.gradle",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "build.gradle.kts",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "settings.gradle"
            },
            {
              "file": "settings.gradle.kts"
            }
          ]
        },
        {
          "any": [
            {
              "file": "build.gradle",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "build.gradle.kts",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "*/build.gradle",
              "matches": "org\\.springframework\\.boot"
            },
            {
              "file": "*/build.gradle.kts",
              "matches": "org\\.springframework\\.boot"
            }
          ]
        }
      ]
    },
    "package": {
      "command": "build",
      "artifacts": [
        "build/libs/*.jar",
        "*/build/libs/*.jar"
      ]
    },
    "compose": {
      "templates": {
        "api": {
          "dev": "module_java_api_dev",
          "prod": "module_java_api_prod"
        },
        "worker": {
          "dev": "module_java_worker_dev",
          "prod": "module_java_worker_prod"
        }
      },
      "opsModules": {
        "kind": "boot",
        "columns": "compose_service|gradle_module|type|dockerfile|enabled",
        "embeddedWorker": "{worker_service}|worker|boot|worker/Dockerfile|yes",
        "shared": {
          "marker": "shared/build.gradle.kts",
          "row": "|shared|library||yes"
        }
      }
    },
    "container": {
      "template": "container/Dockerfile",
      "port": 8080,
      "artifact": "build/libs/*.jar",
      "artifactExclude": [
        "*-plain.jar"
      ],
      "probe": {
        "tcp": "bash -c 'exec 3<>/dev/tcp/127.0.0.1/{port}' || exit 1",
        "http": "bash -c 'exec 3<>/dev/tcp/127.0.0.1/{port} && printf \"GET {path} HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n\" >&3 && head -n1 <&3 | grep -q \" [23][0-9][0-9] \"' || exit 1"
      }
    },
    "dev": {
      "image": "eclipse-temurin:{toolchain.version|17}-jdk",
      "command": [
        "sh",
        "-c",
        "exec ./gradlew bootRun --no-daemon -x test"
      ],
      "build": [
        "sh",
        "-c",
        "./gradlew classes --no-daemon -x test"
      ],
      "port": 8080,
      "caches": {
        "gradle": "/root/.gradle"
      },
      "excludes": [
        "build/",
        ".gradle/",
        "out/"
      ],
      "reactions": [
        {
          "globs": [
            "*.gradle",
            "*.gradle.kts",
            "gradle/**",
            "gradle.properties"
          ],
          "do": "restart"
        },
        {
          "globs": [
            "src/main/java/**",
            "src/main/kotlin/**"
          ],
          "do": "rebuild"
        }
      ]
    },
    "generated": [
      "build",
      ".gradle",
      "out",
      "target"
    ]
  },
  "node-vite": {
    "label": "Node — SPA dev remote + static deploy (Vite, Angular, Nx)",
    "roles": [
      "ui"
    ],
    "commands": {},
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "label": "{module}: npm run {script}",
      "values": {
        "script": [
          {
            "field": "debug.npmScript"
          },
          {
            "field": "debug.script"
          },
          {
            "driver": "packageScripts.start"
          },
          {
            "value": "dev"
          }
        ]
      },
      "launch": {
        "name": "{label}",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run {script}",
        "cwd": "{path}"
      }
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "remote-dev": {
        "via": "dev"
      },
      "release": {
        "via": "release"
      }
    },
    "packageScripts": {
      "lint": "lint",
      "build": "build",
      "test": "test",
      "audit": "audit"
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-node",
          "with": {
            "node-version": "{toolchain.version|22}"
          }
        },
        {
          "run": "corepack enable"
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "package.json"
        },
        {
          "any": [
            {
              "file": "vite.config.ts"
            },
            {
              "file": "vite.config.js"
            },
            {
              "file": "vite.config.mjs"
            }
          ]
        }
      ]
    },
    "package": {
      "command": "build",
      "artifacts": [
        "dist/**"
      ]
    },
    "compose": {
      "templates": {
        "ui": {
          "dev": "module_ui_stack_dev",
          "prod": "module_ui_stack_prod"
        }
      },
      "dockerfiles": {
        "dev": "Dockerfile",
        "prod": "Dockerfile"
      }
    },
    "nginx": {
      "serves": true
    },
    "container": {
      "static": {
        "image": "nginxinc/nginx-unprivileged:1.27-alpine",
        "mount": "/usr/share/nginx/html",
        "config": "../_shared/static/spa.conf",
        "configMount": "/etc/nginx/conf.d/default.conf"
      },
      "serve": "dist",
      "port": 8080,
      "builtChecks": true,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://127.0.0.1:{port}/healthz || exit 1"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 3
      }
    },
    "dev": {
      "image": "node:{toolchain.version|22}-alpine",
      "command": [
        "sh",
        "-c",
        "corepack enable >/dev/null 2>&1; if [ -f pnpm-lock.yaml ]; then pnpm install && exec pnpm run dev --host 0.0.0.0; elif [ -f yarn.lock ]; then yarn install && exec yarn dev --host 0.0.0.0; else npm install && exec npm run dev -- --host 0.0.0.0; fi"
      ],
      "port": 5173,
      "caches": {
        "modules": "/workspace/node_modules"
      },
      "excludes": [
        "node_modules/",
        "dist/"
      ],
      "reactions": [
        {
          "globs": [
            "package.json",
            "pnpm-lock.yaml",
            "package-lock.json",
            "yarn.lock"
          ],
          "do": "restart"
        }
      ]
    },
    "generated": [
      "node_modules",
      "dist"
    ]
  },
  "node-api": {
    "label": "Node — HTTP service (pnpm build + dockerized deploy, Fastify/Express/Nest)",
    "roles": [
      "api"
    ],
    "commands": {},
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "label": "{module}: npm run {script}",
      "values": {
        "script": [
          {
            "field": "debug.npmScript"
          },
          {
            "field": "debug.script"
          },
          {
            "driver": "packageScripts.start"
          },
          {
            "value": "dev"
          }
        ]
      },
      "launch": {
        "name": "{label}",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run {script}",
        "cwd": "{path}"
      }
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "remote-dev": {
        "via": "dev"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "release": {
        "via": "release"
      }
    },
    "packageScripts": {
      "lint": "lint",
      "build": "build",
      "test": "test",
      "audit": "audit"
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-node",
          "with": {
            "node-version": "{toolchain.version|22}"
          }
        },
        {
          "run": "corepack enable"
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "package.json",
          "matches": "\"(express|fastify|@nestjs/core|koa|@hapi/hapi)\"\\s*:"
        },
        {
          "none": "angular.json"
        },
        {
          "none": "vite.config.*"
        }
      ]
    },
    "package": {
      "command": "build",
      "artifacts": [
        "dist/**",
        "package.json",
        "pnpm-lock.yaml",
        "package-lock.json",
        "yarn.lock"
      ]
    },
    "container": {
      "template": "container/Dockerfile",
      "port": 3000,
      "probe": {
        "tcp": "nc -z 127.0.0.1 {port} || exit 1",
        "http": "wget -q -O /dev/null http://127.0.0.1:{port}{path} || exit 1"
      }
    },
    "dev": {
      "image": "node:{toolchain.version|22}-alpine",
      "command": [
        "sh",
        "-c",
        "corepack enable >/dev/null 2>&1; if [ -f pnpm-lock.yaml ]; then pnpm install && exec pnpm run dev ; elif [ -f yarn.lock ]; then yarn install && exec yarn dev ; else npm install && exec npm run dev -- ; fi"
      ],
      "port": 3000,
      "caches": {
        "modules": "/workspace/node_modules"
      },
      "excludes": [
        "node_modules/",
        "dist/"
      ],
      "reactions": [
        {
          "globs": [
            "package.json",
            "pnpm-lock.yaml",
            "package-lock.json",
            "yarn.lock"
          ],
          "do": "restart"
        }
      ]
    },
    "generated": [
      "node_modules",
      "dist"
    ]
  },
  "dotnet-aspnet": {
    "label": "ASP.NET Core - dotnet run / dotnet publish artifact (Windows or cross-platform host)",
    "roles": [
      "api"
    ],
    "commands": {
      "package": "ps1/package.ps1",
      "check": "ps1/check.ps1",
      "build": "ps1/build.ps1",
      "test": "ps1/test.ps1",
      "lint": "ps1/lint.ps1",
      "audit": "ps1/audit.ps1"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "label": "{module}: dotnet run",
      "values": {
        "project": [
          {
            "field": "dotnet.project",
            "exists": true
          },
          {
            "glob": "*.csproj",
            "single": true
          }
        ]
      },
      "launch": {
        "name": "{label}",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "{path}/{project}",
        "launchConfigurationId": "TargetFramework=;{dotnet.launchProfile}"
      },
      "optional": [
        "launchConfigurationId"
      ]
    },
    "migrations": {
      "globs": [
        "**/Migrations/*.cs"
      ],
      "exclude": [
        "**/Migrations/*.Designer.cs",
        "**/Migrations/*ModelSnapshot.cs"
      ],
      "data": [
        "\\.(InsertData|UpdateData|DeleteData)\\s*\\(",
        "(?i)\\.Sql\\s*\\(\\s*@?\\$?\\\"\\s*(insert\\s+into|update\\s+\\S+\\s+set|delete\\s+from)"
      ]
    },
    "delivery": {
      "local": {
        "command": "run"
      },
      "hybrid": {
        "via": "hybrid"
      },
      "remote-dev": {
        "via": "dev"
      },
      "release": {
        "via": "release"
      }
    },
    "ci": {
      "setup": [
        {
          "uses": "actions/setup-dotnet",
          "with": {
            "dotnet-version": "{toolchain.version|8.0.x}"
          }
        }
      ]
    },
    "detect": {
      "all": [
        {
          "file": "*.csproj",
          "matches": "Sdk=\"Microsoft\\.NET\\.Sdk\\.Web\""
        }
      ],
      "reads": {
        "dotnet.project": {
          "name": "*.csproj",
          "matches": "Sdk=\"Microsoft\\.NET\\.Sdk\\.Web\""
        },
        "dotnet.test": {
          "find": "**/*.csproj",
          "matches": "Microsoft\\.NET\\.Test\\.Sdk",
          "mentions": "dotnet.project"
        }
      }
    },
    "package": {
      "command": "package",
      "args": [
        "-Output",
        "{out}"
      ],
      "artifacts": [
        "{out}"
      ]
    },
    "container": {
      "template": "container/Dockerfile",
      "port": 8080,
      "entry": "{dotnet.project|app.csproj|:stem}.dll",
      "probe": {
        "tcp": "bash -c 'exec 3<>/dev/tcp/127.0.0.1/{port}' || exit 1",
        "http": "bash -c 'exec 3<>/dev/tcp/127.0.0.1/{port} && printf \"GET {path} HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n\" >&3 && head -n1 <&3 | grep -q \" [23][0-9][0-9] \"' || exit 1"
      }
    },
    "dev": {
      "image": "mcr.microsoft.com/dotnet/sdk:{toolchain.version|8.0|:majorminor}",
      "command": [
        "dotnet",
        "watch",
        "run",
        "--project",
        "{dotnet.project|.}",
        "--urls",
        "http://0.0.0.0:8080",
        "--non-interactive"
      ],
      "port": 8080,
      "caches": {
        "nuget": "/root/.nuget/packages"
      },
      "excludes": [
        "bin/",
        "obj/"
      ],
      "reactions": [
        {
          "globs": [
            "*.csproj",
            "*.sln",
            "Directory.*.props"
          ],
          "do": "restart"
        }
      ]
    },
    "generated": [
      "bin",
      "obj"
    ]
  },
