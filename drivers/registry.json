{
  "java-boot": {
    "label": "JVM — Gradle / Spring Boot (multi-module JAR deploy)",
    "roles": [
      "api",
      "worker"
    ],
    "configGen": true,
    "acceptsGlobalCredentials": true,
    "deployKind": "runtime",
    "deployArgs": [
      "all"
    ],
    "layoutSimulator": "simulate-backend-layout.ps1",
    "runtime": "bash",
    "commands": {
      "deploy": "sh/deploy.sh",
      "dev": "sh/dev.sh",
      "run": "ps1/run.ps1",
      "manage": "sh/manage.sh",
      "compose": "sh/compose.sh",
      "check": "sh/check.sh",
      "modules": "sh/modules.sh"
    },
    "tasks": {
      "devWatch": [
        "dev",
        "watch"
      ]
    },
    "vscode": {
      "launch": "java"
    }
  },
  "node-vite": {
    "label": "Node — SPA dev remote + static deploy (Vite, Angular, Nx)",
    "roles": [
      "ui"
    ],
    "deployKind": "static",
    "deployArgs": [
      "dist",
      "-Environment",
      "{environment}"
    ],
    "layoutSimulator": "simulate-frontend-layout.ps1",
    "runtime": "powershell",
    "commands": {
      "deploy": "ps1/deploy.ps1",
      "dev": "ps1/dev.ps1",
      "run": "ps1/run.ps1",
      "manage": "ps1/manage.ps1",
      "compose": "ps1/compose.ps1",
      "check": "ps1/check.ps1"
    },
    "tasks": {
      "devWatch": [
        "dev",
        "watch"
      ],
      "deployWatch": [
        "deploy",
        "watch"
      ]
    },
    "vscode": {
      "launch": "node-terminal"
    }
  },
  "node-api": {
    "label": "Node — HTTP service (pnpm build + dockerized deploy, Fastify/Express/Nest)",
    "roles": [
      "api"
    ],
    "deployKind": "runtime",
    "runtime": "bash",
    "commands": {
      "deploy": "sh/deploy.sh",
      "dev": "sh/dev.sh",
      "run": "ps1/run.ps1",
      "manage": "sh/manage.sh",
      "compose": "sh/compose.sh",
      "check": "sh/check.sh",
      "modules": "sh/modules.sh"
    },
    "tasks": {
      "devWatch": [
        "dev",
        "watch"
      ]
    },
    "vscode": {
      "launch": "node-terminal"
    }
  },
  "dotnet-aspnet": {
    "label": "ASP.NET Core - dotnet run / dotnet publish artifact (Windows or cross-platform host)",
    "roles": [
      "api"
    ],
    "deployKind": "artifact",
    "deployArgs": [
      "artifact"
    ],
    "runtime": "powershell",
    "commands": {
      "deploy": "ps1/deploy.ps1",
      "run": "ps1/run.ps1",
      "check": "ps1/check.ps1"
    },
    "hybrid": {
      "script": "ps1/hybrid.ps1"
    },
    "tasks": {},
    "vscode": {
      "launch": "dotnet"
    }
  }
}
