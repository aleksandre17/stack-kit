{
  "schema_version": 1,
  "points": [
    {
      "id": "manifest",
      "purpose": "the project's manifest",
      "host_path": "stack-kit.json",
      "template": "scaffold/stack-kit.json",
      "schema": "manifest.schema.json",
      "cardinality": "one",
      "required_by": "init",
      "merges_into": "instance"
    },
    {
      "id": "module",
      "purpose": "a module of the project (no name: drafted from the tree by the drivers' evidence)",
      "host_path": "stack-kit.json#/modules/<name>",
      "template": "config/extension-templates/module.json",
      "schema": "manifest.schema.json#/properties/modules",
      "cardinality": "many",
      "required_by": null,
      "merges_into": "instance"
    },
    {
      "id": "catalog-roles",
      "purpose": "a role over the kit's (config/catalogs/roles.json)",
      "host_path": "stack-kit.json#/catalogs/roles/-",
      "template": "config/extension-templates/catalog-roles.json",
      "schema": null,
      "cardinality": "many",
      "required_by": null,
      "merges_into": "catalog"
    },
    {
      "id": "catalog-tiers",
      "purpose": "a tier over the kit's",
