{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stack-kit deploy targets (tracked, non-secret)",
  "description": "Named deploy targets a host declares in the file its manifest names (`deploy.targets`), merged under a gitignored `<name>.local.json` beside it. No secret is ever a value here: an identity is a reference (ADR-001 amendment 9).",
  "type": "object",
  "required": [
    "schema",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "defaults": {
      "type": "object",
      "description": "The target each environment (catalogs.environments) deploys to when no --target is given",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "runtime"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "pending": {
            "type": "string",
            "minLength": 1,
            "description": "Declared, not reachable yet, and why: printed by validate and targets, refused by every deploy"
          },
          "runtime": {
            "type": "string",
            "minLength": 1,
            "description": "What runs the deployed module there (catalogs.targetRuntimes: docker-compose, static, iis, or a host's)"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "user": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 22
          },
          "root": {
            "type": "string",
            "pattern": "^(/|[A-Za-z]:[/\\\\])",
            "description": "The absolute directory the platform shares between projects; this project's own is {root}/{project}. Never acted on itself"
          },
          "ssh": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "^(agent|env:[A-Za-z_][A-Za-z0-9_]*|file:[^\\s]+)$",
                "description": "A reference, never a key: `agent` (the running ssh-agent), `env:VAR` (a variable naming the key file), `file:<repo path>` (an ignored key file)"
              },
              "knownHosts": {
                "type": "string",
                "minLength": 1,
                "description": "A tracked file of this target's pinned host keys (default: the machine's own known_hosts, still strict)"
              },
              "hostKeys": {
                "enum": [
                  "pinned",
                  "accept-new"
                ],
                "default": "pinned",
                "description": "accept-new is trust on first use, only when declared"
              },
              "config": {
                "type": "string",
                "minLength": 1,
                "description": "An ssh config file (ssh -F)"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z]+=\\S+$"
                },
                "description": "Further `-o Key=Value` options; host-key checking is `hostKeys`'s alone"
              }
            },
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "description": "Path templates over the kit's default (config/deploy-layout.default.json); every rendered path must lie under `project`",
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "logs": {
                "type": "string",
                "minLength": 1
              },
              "releases": {
                "type": "string",
                "minLength": 1
              },
              "current": {
                "type": "string",
                "minLength": 1
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "workspace": {
                "type": "string",
                "minLength": 1
              },
              "stack": {
                "type": "string",
                "minLength": 1
              },
              "stackCompose": {
                "type": "string",
                "minLength": 1
              },
              "stackEnv": {
                "type": "string",
                "minLength": 1
              },
              "stackState": {
                "type": "string",
                "minLength": 1
              },
              "infra": {
                "type": "string",
                "minLength": 1
              },
              "backups": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "ports": {
            "type": "object",
            "description": "Host ports each service publishes, per environment: unique per host across every target and environment (validate), and refused at deploy when another compose project publishes one",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          },
          "keep": {
            "type": "integer",
            "minimum": 1,
            "default": 5,
            "description": "Releases a unit keeps: the prune limit (never `current`), and what verify holds"
          },
          "health": {
            "type": "object",
            "description": "Health URLs per environment and service, checked by `targets --health` after every deploy",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          },
          "runner": {
            "type": "string",
            "minLength": 1,
            "description": "The CI runner a deploy to this target runs on (default ubuntu-latest)"
          },
          "compose": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "This target's compose invocation over its runtime's (catalogs.targetRuntimes `compose`), e.g. [\"docker-compose\"] on a host with only the standalone binary"
          },
          "engine": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "This target's container engine invocation over its runtime's (`engine`)"
          },
          "healthWait": {
            "type": "object",
            "properties": {
              "retries": {
                "type": "integer",
                "minimum": 1
              },
              "interval": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "description": "How long a deploy waits for a service to be healthy (default config/delivery.json)"
          },
          "minFreeMb": {
            "type": "integer",
            "minimum": 0,
            "description": "The free disk the preflight requires under the project's directory"
          },
          "legacyLayout": {
            "type": "object",
            "description": "This project's paths in a tree laid out before the layout, for `layout migrate` to plan their move (applied only with --approve). Every path at least two levels under the root: the root's own children are shared between projects",
            "properties": {
              "environment": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^\\{root\\}/"
                }
              },
              "places": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "infra",
                    "backups",
                    "stack"
                  ]
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^\\{root\\}/"
                }
              }
            },
            "additionalProperties": false
          },
          "logging": {
            "type": "object",
            "description": "Container log rotation for this target's stacks (compose `logging`; default config/delivery.json)"
          },
          "oidc": {
            "type": "object",
            "description": "Per environment: the OIDC provider the services trust, checked by `targets --health` (discovery names the issuer, JWKS has a signing key): {issuer, caFile (the internal CA's certificate, from `tls truststore`)}",
            "additionalProperties": {
              "type": "object",
              "required": [
                "issuer"
              ],
              "properties": {
                "issuer": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "caFile": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
