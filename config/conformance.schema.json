{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "standards conformance map",
  "type": "object",
  "required": [
    "schema",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema": {
      "const": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "standard",
          "clause",
          "mechanism",
          "evidence",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "standard": {
            "type": "string",
            "minLength": 1
          },
          "clause": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "conformant",
              "partial",
              "gap",
              "non-goal"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
