# Environment contract -- see kits/stack-kit/docs/ADOPT.md (configuration)
#
# Names (compose services, containers, networks, the directory on a server) all come from the
# manifest's `project` (lib/naming.py); where a deploy goes is ops/deploy/targets.json. No env file
# names a server, a project or a service (stack-kit 2.0.0).

# --- frontend (.env.dev / .env.prod) ---
# VITE_API_URL=http://localhost:8090

# --- backend (.env.dev / .env.prod) ---
# API_PORT=8090
