# The edge's server (nginx renders ${VARIABLES} from the container's environment at start).
# TLS 1.2+ only, HSTS, security headers; plain http only redirects (and answers /healthz).
server {
    listen 8080;
    server_tokens off;
    location = /healthz { access_log off; add_header Content-Type text/plain; return 200 "ok"; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 8443 ssl;
    http2 on;
    server_name ${EDGE_SERVER_NAME};
    server_tokens off;
    ssl_certificate /etc/nginx/tls/${EDGE_SERVER_NAME}.crt;
    ssl_certificate_key /etc/nginx/tls/${EDGE_SERVER_NAME}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:edge:10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    client_max_body_size 50m;
    location = /healthz { access_log off; add_header Content-Type text/plain; return 200 "ok"; }
    location / {
        proxy_pass http://${EDGE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
map $http_upgrade $connection_upgrade { default upgrade; "" close; }
